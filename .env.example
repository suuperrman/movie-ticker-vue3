# ===== 后端 API 基础路径 =====
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://localhost:8085

# ===== 阿里云 OSS 非敏感配置 =====
# 这三个值是公开信息（bucket 地址、区域），前端直传 OSS 时需要
# 注意：access-key-id / access-key-secret 绝对不能写前端！
#       前端通过 /oss/sts 接口从后端拿临时凭证（SecurityToken）
VITE_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
VITE_OSS_BUCKET=xiong-movie-ticket
VITE_OSS_REGION=cn-beijing
